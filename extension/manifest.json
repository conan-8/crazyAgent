{
  "manifest_version": 3,
  "name": "crazyAgent",
  "version": "0.1.0",
  "description": "AI browser agent in a sidebar that operates your browser.",
  "minimum_chrome_version": "114",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "alarms",
    "sidePanel",
    "debugger",
    "scripting",
    "tabs",
    "bookmarks",
    "topSites",
    "storage",
    "unlimitedStorage",
    "cookies",
    "downloads",
    "webNavigation",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "nativeMessaging",
    "clipboardWrite",
    "offscreen",
    "activeTab"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background/sw.js"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "action": {
    "default_title": "crazyAgent",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/main.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
