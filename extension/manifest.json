{
  "manifest_version": 3,
  "name": "crazyAgent",
  "version": "2.1.0",
  "version_name": "2.1.0-beta",
  "description": "A DeepSeek-optimised browser agent for guarded Chrome/Edge actions, file transfer, and Google Docs editing.",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "alarms",
    "tabs",
    "scripting",
    "storage",
    "clipboardRead",
    "clipboardWrite",
    "debugger",
    "downloads",
    "webNavigation",
    "topSites",
    "bookmarks",
    "history"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/cursor-16.png",
    "32": "icons/cursor-32.png",
    "48": "icons/cursor-48.png",
    "128": "icons/cursor-128.png"
  },
  "action": {
    "default_title": "Open crazyAgent",
    "default_icon": {
      "16": "icons/cursor-16.png",
      "32": "icons/cursor-32.png",
      "48": "icons/cursor-48.png",
      "128": "icons/cursor-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  }
}
