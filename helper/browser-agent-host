#!/bin/sh
# Native-messaging host entry point (stable path for the manifest).
# Chrome spawns hosts with a minimal PATH, so locate node explicitly.
DIR="$(cd "$(dirname "$0")" && pwd)"
for NODE in "$(command -v node 2>/dev/null)" /usr/bin/node /usr/local/bin/node "$HOME/.local/bin/node" "$HOME"/.nvm/versions/node/*/bin/node; do
  [ -x "$NODE" ] && exec "$NODE" "$DIR/daemon.mjs" 2>>/tmp/ba-daemon.log
done
echo "browser-agent-host: node runtime not found" >> /tmp/ba-daemon.log
exit 1
