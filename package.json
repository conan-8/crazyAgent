{
  "name": "crazyagent",
  "version": "2.2.0",
  "private": true,
  "type": "module",
  "description": "DeepSeek-optimised Chrome/Edge browser agent with guarded actions and Google Docs editing",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24.9.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "test": "node --test \"companion/test/**/*.test.mjs\" \"extension/test/**/*.test.mjs\" \"packages/dsh-browser-extension/test/**/*.test.mjs\"",
    "bench": "node scripts/bench.mjs",
    "clean": "node scripts/clean.mjs",
    "system-prompt": "node scripts/print-system-prompt.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.2.2-rc.1",
    "@deepseek-ai/dsh-browser-use": "0.2.2-rc.1",
    "@deepseek-ai/dsh-credentials-local": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.2-rc.1",
    "@deepseek-ai/dsh-sdk-client": "0.2.2-rc.1",
    "fflate": "^0.8.3",
    "google-auth-library": "^10.9.1",
    "js-yaml": "^4.3.2",
    "ws": "^8.18.0"
  },
  "overrides": {
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/core": "2.4.0",
    "@deepseek-ai/libreoffice-kit": {
      "fflate": "0.8.3"
    },
    "undici": "8.12.4",
    "zod": "4.6.7"
  }
}
