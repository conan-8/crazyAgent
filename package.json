{
  "name": "browser-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI browser agent as a Chromium sidebar extension with full browser control",
  "scripts": {
    "build": "node build/build.mjs",
    "watch": "node build/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "node scripts/verify.mjs",
    "e2e": "node scripts/verify.mjs"
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "marked": "^18.0.14",
    "preact": "^10.25.4"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.300",
    "esbuild": "^0.25.0",
    "jsdom": "^30.1.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
