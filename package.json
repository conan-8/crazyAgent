{
  "name": "crazyagent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Phase 1: DSH-powered vision browser agent in a Chrome side panel",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
